MONGODB_URI=mongodb://127.0.0.1:27017/vasantham
JWT_SECRET=your_jwt_secret_here
NEXT_PUBLIC_SITE_URL=https://vasanthamonline.com

# Cloudinary Configuration (optional - uploads fallback to local filesystem if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# MSG91 WhatsApp OTP Configuration
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_WHATSAPP_INTEGRATED_NUMBER=your_whatsapp_business_number_here
MSG91_WHATSAPP_TEMPLATE_NAME=your_otp_template_name_here
MSG91_NAMESPACE=your_meta_namespace_here

# SMTP Email (OTP codes) – e.g. Gmail app password, Zoho, or your vasanthamonline.com mailbox
# Port 587 = STARTTLS, 465 = SSL. Leave blank in development to print codes in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vasantham Online <no-reply@vasanthamonline.com>"
